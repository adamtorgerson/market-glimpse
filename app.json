{
  "package_id": "com.bcsw.marketglimpse",
  "edition": "202601",
  "name": "MarketGlimpse",
  "version": "0.4.6",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Fetches market data from your exchange (Kraken, OKX, Coinbase, Gate, Binance, Binance.US, Bitget, Hyperliquid, Aster) or prediction market (Polymarket, Hyperliquid Outcomes), index prices from CoinGecko, and headlines from the news sources you tick (some fetched via Jina Reader).",
      "whitelist": [
        "https://api.kraken.com",
        "https://www.okx.com",
        "https://api.exchange.coinbase.com",
        "https://api.gateio.ws",
        "https://api.binance.com",
        "https://api.binance.us",
        "https://api.bitget.com",
        "https://api.hyperliquid.xyz",
        "https://sapi.asterdex.com",
        "https://gamma-api.polymarket.com",
        "https://clob.polymarket.com",
        "https://gateway.polymarket.us",
        "https://api.coingecko.com",
        "https://www.cnbc.com",
        "https://feeds.content.dowjones.io",
        "https://news.bitcoin.com",
        "https://cryptocurrency.cv",
        "https://r.jina.ai"
      ]
    }
  ],
  "supported_languages": ["en"]
}
