{
  "package_id": "com.bcsw.marketglimpse",
  "edition": "202601",
  "name": "MarketGlimpse",
  "version": "0.3.4",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Fetches public market data from the selected exchange (Kraken, OKX, Coinbase or Gate) and index prices from CoinGecko.",
      "whitelist": [
        "https://api.kraken.com",
        "https://www.okx.com",
        "https://api.exchange.coinbase.com",
        "https://api.gateio.ws",
        "https://api.coingecko.com"
      ]
    }
  ],
  "supported_languages": ["en"]
}
