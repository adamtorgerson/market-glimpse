{
  "package_id": "com.bcsw.marketglimpse",
  "edition": "202601",
  "name": "MarketGlimpse",
  "version": "0.4.6",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Fetches public market data from the selected exchange (Kraken, OKX, Coinbase, Gate, Binance, Binance.US, Bitget, Hyperliquid, Aster) or prediction market (Polymarket, Hyperliquid Outcomes), index prices from CoinGecko, and headlines from news sources you tick (CNBC, MarketWatch, cryptocurrency.cv).",
      "whitelist": [
        "https://api.kraken.com",
        "https://www.okx.com",
        "https://api.exchange.coinbase.com",
        "https://api.gateio.ws",
        "https://api.binance.com",
        "https://api.binance.us",
        "https://api.bitget.com",
        "https://api.hyperliquid.xyz",
        "https://sapi.asterdex.com",
        "https://gamma-api.polymarket.com",
        "https://clob.polymarket.com",
        "https://gateway.polymarket.us",
        "https://api.coingecko.com",
        "https://www.cnbc.com",
        "https://feeds.content.dowjones.io",
        "https://cryptocurrency.cv"
      ]
    }
  ],
  "supported_languages": ["en"]
}
