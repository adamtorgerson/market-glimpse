{
  "package_id": "com.bcsw.marketglimpse",
  "edition": "202601",
  "name": "MarketGlimpse",
  "version": "0.3.6",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Fetches public market data from the selected exchange (Kraken, OKX, Coinbase, Gate, Binance.US or Bitget) or prediction market (Polymarket, Polymarket US), and index prices from CoinGecko.",
      "whitelist": [
        "https://api.kraken.com",
        "https://www.okx.com",
        "https://api.exchange.coinbase.com",
        "https://api.gateio.ws",
        "https://api.binance.us",
        "https://api.bitget.com",
        "https://gamma-api.polymarket.com",
        "https://clob.polymarket.com",
        "https://gateway.polymarket.us",
        "https://api.coingecko.com"
      ]
    }
  ],
  "supported_languages": ["en"]
}
